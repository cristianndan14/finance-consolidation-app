# Copiar a .env y completar. .env NUNCA se commitea.

# ─── Entorno ─────────────────────────────────────────────────────────────────
ENV=development                  # development | production
LOG_LEVEL=INFO
BASE_URL=http://localhost:8000

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard -> Project Settings -> API
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Solo la usa app/infra/supabase_admin.py (invitaciones, seed, reaper).
# Ver el inventario cerrado de usos en el plan, seccion 1.
SUPABASE_SERVICE_ROLE_KEY=
# Los proyectos hosted nuevos firman los JWT con claves asimetricas y el backend
# las lee del JWKS: no hace falta configurar nada. Dejar vacia salvo con el
# Supabase local, que todavia firma con HS256 (`supabase status` la imprime).
SUPABASE_JWT_SECRET=

# ─── Postgres ────────────────────────────────────────────────────────────────
# El backend se conecta con el rol app_runtime, que NO tiene BYPASSRLS.
# Es lo que hace que RLS sea real y no aparente: si un query olvida el filtro
# por user_id, Postgres devuelve 0 filas en lugar de las filas de otro usuario.
DATABASE_URL=postgresql+asyncpg://app_runtime:app_runtime_dev@127.0.0.1:54322/postgres
APP_RUNTIME_PASSWORD=app_runtime_dev

# Solo para migraciones y tests. NUNCA en el proceso servidor.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# ─── Sesion ──────────────────────────────────────────────────────────────────
# Cookie httpOnly firmada. Generar con: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_NAME=fc_session
SESSION_MAX_AGE_SECONDS=1209600
# Margen con el que se renueva el access token antes de que expire.
SESSION_REFRESH_MARGIN_SECONDS=120
# `Secure` en la cookie. Sin setear = activado solo si ENV=production.
# SESSION_COOKIE_SECURE=true

# ─── LLM ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini             # gemini | mistral | fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
# Tope duro de gasto por usuario y por mes. Corta antes de encolar.
LLM_MONTHLY_BUDGET_USD=5.00
# Llamadas simultaneas al modelo. No es por rendimiento: sin tope, un resumen
# de 12 paginas dispara 12 llamadas juntas y la mitad vuelve con 429.
LLM_MAX_CONCURRENCY=3

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_BUCKET=statements
MAX_UPLOAD_BYTES=20971520       # 20 MB
MAX_PDF_PAGES=40

# ─── Jobs ────────────────────────────────────────────────────────────────────
JOB_POLL_SECONDS=5
JOB_CONCURRENCY=2
JOB_STALE_MINUTES=10
